# Commands use Podman by default. Codex uses your existing `codex login`.
FPGA_LAB_RUNTIME=podman
FPGA_LAB_IMAGE=xls-e2e-tools:local
# Optional model override; otherwise use the model in ~/.codex/config.toml.
# CODEX_MODEL=your-model

# Optional legacy Responses API experiment only:
# OPENAI_API_KEY=
# ASTRA_MODEL=your-model
# ASTRA_BASE_URL=https://your-endpoint
